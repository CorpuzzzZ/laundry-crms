using Microsoft.EntityFrameworkCore;
using CRM.Domain.Entities.TenantDb;

namespace CRM.infrastructure.Data.Context
{
    public class TenantDbContext : DbContext
    {
        public TenantDbContext(DbContextOptions<TenantDbContext> options)
            : base(options)
        {
        }

        public DbSet<Customer> Customers { get; set; }
        public DbSet<CustomerAddress> CustomerAddresses { get; set; }
        public DbSet<CustomerLoyalty> CustomerLoyalties { get; set; }
        public DbSet<LoyaltyTier> LoyaltyTiers { get; set; }
        public DbSet<LoyaltySetting> LoyaltySettings { get; set; }
        public DbSet<LoyaltyTransaction> LoyaltyTransactions { get; set; }
        public DbSet<ServiceCategory> ServiceCategories { get; set; }
        public DbSet<Service> Services { get; set; }
        public DbSet<GarmentType> GarmentTypes { get; set; }
        public DbSet<PriceMatrix> PriceMatrices { get; set; }
        public DbSet<Order> Orders { get; set; }
        public DbSet<OrderStatus> OrderStatuses { get; set; }
        public DbSet<OrderItem> OrderItems { get; set; }
        public DbSet<OrderStatusHistory> OrderStatusHistories { get; set; }
        public DbSet<OrderPayment> OrderPayments { get; set; }
        public DbSet<PaymentMethod> PaymentMethods { get; set; }
        public DbSet<Notification> Notifications { get; set; }
        public DbSet<Report> Reports { get; set; }
        public DbSet<ScheduledReport> ScheduledReports { get; set; }
        public DbSet<InventoryItem> InventoryItems { get; set; }
        public DbSet<InventoryTransaction> InventoryTransactions { get; set; }
        public DbSet<EmployeeWorkLog> EmployeeWorkLogs { get; set; }

        protected override void OnModelCreating(ModelBuilder builder)
        {
            base.OnModelCreating(builder);

            // Customer Configuration
            builder.Entity<Customer>(entity =>
            {
                entity.HasKey(x => x.CustomerId);
                entity.Property(x => x.CustomerCode).HasMaxLength(50).IsRequired();
                entity.Property(x => x.CustomerType).HasMaxLength(20).IsRequired().HasDefaultValue("Individual");
                entity.Property(x => x.CompanyName).HasMaxLength(200);
                entity.Property(x => x.FirstName).HasMaxLength(100).IsRequired();
                entity.Property(x => x.LastName).HasMaxLength(100).IsRequired();
                entity.Property(x => x.Email).HasMaxLength(255);
                entity.Property(x => x.PhonePrimary).HasMaxLength(20).IsRequired();
                entity.Property(x => x.Street).HasMaxLength(200);
                entity.Property(x => x.Village).HasMaxLength(200);
                entity.HasIndex(x => x.CustomerCode).IsUnique();
                entity.HasIndex(x => x.Email);
                entity.HasIndex(x => x.PhonePrimary);
            });

            // CustomerAddress Configuration
            builder.Entity<CustomerAddress>(entity =>
            {
                entity.HasKey(x => x.CustomerAddressId);
                entity.Property(x => x.AddressType).HasMaxLength(20).IsRequired();
                entity.Property(x => x.AddressLine1).HasMaxLength(200).IsRequired();
                entity.Property(x => x.AddressLine2).HasMaxLength(200);
                entity.Property(x => x.City).HasMaxLength(100).IsRequired();
                entity.Property(x => x.State).HasMaxLength(50).IsRequired();
                entity.Property(x => x.PostalCode).HasMaxLength(20).IsRequired();
                entity.Property(x => x.Country).HasMaxLength(50).IsRequired().HasDefaultValue("Philippines");

                entity.HasOne(x => x.Customer)
                    .WithMany(x => x.CustomerAddresses)
                    .HasForeignKey(x => x.CustomerId)
                    .OnDelete(DeleteBehavior.Cascade);
            });

            // CustomerLoyalty Configuration
            builder.Entity<CustomerLoyalty>(entity =>
            {
                entity.HasKey(x => x.CustomerLoyaltyId);
                entity.Property(x => x.CurrentPoints).HasDefaultValue(0);
                entity.Property(x => x.TotalPointsEarned).HasDefaultValue(0);
                entity.Property(x => x.TotalPointsRedeemed).HasDefaultValue(0);
                entity.Property(x => x.LifetimeSpend).HasPrecision(18, 2).HasDefaultValue(0);

                entity.HasOne(x => x.Customer)
                    .WithOne(x => x.CustomerLoyalty)
                    .HasForeignKey<CustomerLoyalty>(x => x.CustomerId)
                    .OnDelete(DeleteBehavior.Cascade);

                entity.HasOne(x => x.LoyaltyTier)
                    .WithMany(x => x.CustomerLoyalties)
                    .HasForeignKey(x => x.LoyaltyTierId)
                    .OnDelete(DeleteBehavior.SetNull);
            });

            // LoyaltyTier Configuration
            builder.Entity<LoyaltyTier>(entity =>
            {
                entity.HasKey(x => x.LoyaltyTierId);
                entity.Property(x => x.TierName).HasMaxLength(50).IsRequired();
                entity.HasIndex(x => x.TierName).IsUnique();
            });

            // LoyaltySetting Configuration
            builder.Entity<LoyaltySetting>(entity =>
            {
                entity.HasKey(x => x.LoyaltySettingId);
                entity.Property(x => x.PointsPerOrder).HasPrecision(5, 2);
                entity.Property(x => x.PointsPerDollar).HasPrecision(5, 2);
                entity.Property(x => x.RedeemPointsRequired).HasPrecision(5, 2);
                entity.Property(x => x.RedeemDiscountAmount).HasPrecision(18, 2);
            });

            // LoyaltyTransaction Configuration - FIXED: No cascade delete
            builder.Entity<LoyaltyTransaction>(entity =>
            {
                entity.HasKey(x => x.LoyaltyTransactionId);
                entity.Property(x => x.TransactionType).HasMaxLength(20).IsRequired();

                entity.HasOne(x => x.Customer)
                    .WithMany(x => x.LoyaltyTransactions)
                    .HasForeignKey(x => x.CustomerId)
                    .OnDelete(DeleteBehavior.Restrict); // Changed from Cascade to Restrict

                entity.HasOne(x => x.Order)
                    .WithMany(x => x.LoyaltyTransactions)
                    .HasForeignKey(x => x.OrderId)
                    .OnDelete(DeleteBehavior.Restrict); // Changed from SetNull to Restrict
            });

            // ServiceCategory Configuration
            builder.Entity<ServiceCategory>(entity =>
            {
                entity.HasKey(x => x.ServiceCategoryId);
                entity.Property(x => x.CategoryName).HasMaxLength(100).IsRequired();
                entity.Property(x => x.CategoryCode).HasMaxLength(20).IsRequired();
                entity.HasIndex(x => x.CategoryName).IsUnique();
                entity.HasIndex(x => x.CategoryCode).IsUnique();
            });

            // Service Configuration
            builder.Entity<Service>(entity =>
            {
                entity.HasKey(x => x.ServiceId);
                entity.Property(x => x.ServiceCode).HasMaxLength(20).IsRequired();
                entity.Property(x => x.ServiceName).HasMaxLength(200).IsRequired();
                entity.Property(x => x.BasePrice).HasPrecision(18, 2);
                entity.HasIndex(x => x.ServiceCode).IsUnique();

                entity.HasOne(x => x.ServiceCategory)
                    .WithMany(x => x.Services)
                    .HasForeignKey(x => x.ServiceCategoryId)
                    .OnDelete(DeleteBehavior.Cascade);
            });

            // GarmentType Configuration
            builder.Entity<GarmentType>(entity =>
            {
                entity.HasKey(x => x.GarmentTypeId);
                entity.Property(x => x.GarmentCode).HasMaxLength(20).IsRequired();
                entity.Property(x => x.GarmentName).HasMaxLength(100).IsRequired();
                entity.Property(x => x.Category).HasMaxLength(50).IsRequired();
                entity.HasIndex(x => x.GarmentCode).IsUnique();
            });

            // PriceMatrix Configuration
            builder.Entity<PriceMatrix>(entity =>
            {
                entity.HasKey(x => x.PriceMatrixId);
                entity.Property(x => x.ServiceType).HasMaxLength(20).IsRequired();
                entity.Property(x => x.UnitPrice).HasPrecision(18, 2);
                entity.Property(x => x.MinQuantity).HasPrecision(10, 2);
                entity.Property(x => x.MaxQuantity).HasPrecision(10, 2);

                entity.HasOne(x => x.Service)
                    .WithMany(x => x.PriceMatrices)
                    .HasForeignKey(x => x.ServiceId)
                    .OnDelete(DeleteBehavior.Cascade);

                entity.HasOne(x => x.GarmentType)
                    .WithMany(x => x.PriceMatrices)
                    .HasForeignKey(x => x.GarmentTypeId)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            // Order Configuration
            builder.Entity<Order>(entity =>
            {
                entity.HasKey(x => x.OrderId);
                entity.Property(x => x.OrderNumber).HasMaxLength(50).IsRequired();
                entity.Property(x => x.OrderType).HasMaxLength(20).IsRequired().HasDefaultValue("WalkIn");
                entity.Property(x => x.Priority).HasMaxLength(20).IsRequired().HasDefaultValue("Normal");
                entity.Property(x => x.Subtotal).HasPrecision(18, 2);
                entity.Property(x => x.DiscountAmount).HasPrecision(18, 2);
                entity.Property(x => x.TaxAmount).HasPrecision(18, 2);
                entity.Property(x => x.TotalAmount).HasPrecision(18, 2);
                entity.HasIndex(x => x.OrderNumber).IsUnique();
                entity.HasIndex(x => x.OrderDate);

                entity.HasOne(x => x.Customer)
                    .WithMany(x => x.Orders)
                    .HasForeignKey(x => x.CustomerId)
                    .OnDelete(DeleteBehavior.Restrict); // Changed from Cascade to Restrict

                entity.HasOne(x => x.Status)
                    .WithMany(x => x.Orders)
                    .HasForeignKey(x => x.StatusId)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            // OrderStatus Configuration
            builder.Entity<OrderStatus>(entity =>
            {
                entity.HasKey(x => x.StatusId);
                entity.Property(x => x.StatusCode).HasMaxLength(10).IsRequired();
                entity.Property(x => x.StatusName).HasMaxLength(50).IsRequired();
                entity.Property(x => x.ColorCode).HasMaxLength(7);
                entity.HasIndex(x => x.StatusCode).IsUnique();
            });

            // OrderItem Configuration
            builder.Entity<OrderItem>(entity =>
            {
                entity.HasKey(x => x.OrderItemId);
                entity.Property(x => x.Quantity).HasPrecision(10, 2);
                entity.Property(x => x.UnitPrice).HasPrecision(18, 2);
                entity.Property(x => x.DiscountAmount).HasPrecision(18, 2);

                entity.HasOne(x => x.Order)
                    .WithMany(x => x.OrderItems)
                    .HasForeignKey(x => x.OrderId)
                    .OnDelete(DeleteBehavior.Cascade);

                entity.HasOne(x => x.Service)
                    .WithMany(x => x.OrderItems)
                    .HasForeignKey(x => x.ServiceId)
                    .OnDelete(DeleteBehavior.Restrict);

                entity.HasOne(x => x.GarmentType)
                    .WithMany(x => x.OrderItems)
                    .HasForeignKey(x => x.GarmentTypeId)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            // OrderStatusHistory Configuration
            builder.Entity<OrderStatusHistory>(entity =>
            {
                entity.HasKey(x => x.OrderStatusHistoryId);

                entity.HasOne(x => x.Order)
                    .WithMany(x => x.StatusHistory)
                    .HasForeignKey(x => x.OrderId)
                    .OnDelete(DeleteBehavior.Cascade);

                entity.HasOne(x => x.Status)
                    .WithMany(x => x.StatusHistory)
                    .HasForeignKey(x => x.StatusId)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            // OrderPayment Configuration
            builder.Entity<OrderPayment>(entity =>
            {
                entity.HasKey(x => x.OrderPaymentId);
                entity.Property(x => x.Amount).HasPrecision(18, 2);
                entity.Property(x => x.ReferenceNumber).HasMaxLength(100);
                entity.Property(x => x.Status).HasMaxLength(20).IsRequired().HasDefaultValue("Completed");

                entity.HasOne(x => x.Order)
                    .WithMany(x => x.Payments)
                    .HasForeignKey(x => x.OrderId)
                    .OnDelete(DeleteBehavior.Cascade);

                entity.HasOne(x => x.PaymentMethod)
                    .WithMany(x => x.OrderPayments)
                    .HasForeignKey(x => x.PaymentMethodId)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            // PaymentMethod Configuration
            builder.Entity<PaymentMethod>(entity =>
            {
                entity.HasKey(x => x.PaymentMethodId);
                entity.Property(x => x.MethodCode).HasMaxLength(20).IsRequired();
                entity.Property(x => x.MethodName).HasMaxLength(50).IsRequired();
                entity.HasIndex(x => x.MethodCode).IsUnique();
            });

            // Notification Configuration
            builder.Entity<Notification>(entity =>
            {
                entity.HasKey(x => x.NotificationId);
                entity.Property(x => x.Type).HasMaxLength(50).IsRequired();
                entity.Property(x => x.Title).HasMaxLength(200).IsRequired();
                entity.Property(x => x.Link).HasMaxLength(500);
                entity.HasIndex(x => x.UserId);
                entity.HasIndex(x => x.IsRead);
                entity.HasIndex(x => x.CreatedAt);
            });

            // Report Configuration
            builder.Entity<Report>(entity =>
            {
                entity.HasKey(x => x.ReportId);
                entity.Property(x => x.ReportName).HasMaxLength(200).IsRequired();
                entity.Property(x => x.ReportCategory).HasMaxLength(50).IsRequired();
                entity.Property(x => x.ReportType).HasMaxLength(20).IsRequired();
            });

            // ScheduledReport Configuration
            builder.Entity<ScheduledReport>(entity =>
            {
                entity.HasKey(x => x.ScheduledReportId);
                entity.Property(x => x.Frequency).HasMaxLength(20).IsRequired();
                entity.Property(x => x.Format).HasMaxLength(10).IsRequired().HasDefaultValue("PDF");
                entity.HasIndex(x => x.NextRunDate);
            });

            // InventoryItem Configuration
            builder.Entity<InventoryItem>(entity =>
            {
                entity.HasKey(x => x.InventoryItemId);
                entity.Property(x => x.ItemCode).HasMaxLength(50).IsRequired();
                entity.Property(x => x.ItemName).HasMaxLength(200).IsRequired();
                entity.Property(x => x.Category).HasMaxLength(100).IsRequired();
                entity.Property(x => x.UnitOfMeasure).HasMaxLength(20).IsRequired();
                entity.Property(x => x.CurrentStock).HasPrecision(18, 2);
                entity.Property(x => x.ReorderLevel).HasPrecision(18, 2);
                entity.HasIndex(x => x.ItemCode).IsUnique();
            });

            // InventoryTransaction Configuration
            builder.Entity<InventoryTransaction>(entity =>
            {
                entity.HasKey(x => x.InventoryTransactionId);
                entity.Property(x => x.TransactionType).HasMaxLength(20).IsRequired();
                entity.Property(x => x.QuantityChange).HasPrecision(18, 2);
                entity.Property(x => x.QuantityBalance).HasPrecision(18, 2);
                entity.HasIndex(x => x.TransactionDate);

                entity.HasOne(x => x.InventoryItem)
                    .WithMany(x => x.InventoryTransactions)
                    .HasForeignKey(x => x.InventoryItemId)
                    .OnDelete(DeleteBehavior.Cascade);
            });

            // EmployeeWorkLog Configuration
            builder.Entity<EmployeeWorkLog>(entity =>
            {
                entity.HasKey(x => x.WorkLogId);
                entity.Property(x => x.WorkType).HasMaxLength(50).IsRequired();
                entity.HasIndex(x => x.UserId);
                entity.HasIndex(x => x.StartTime);

                entity.HasOne(x => x.Order)
                    .WithMany()
                    .HasForeignKey(x => x.OrderId)
                    .OnDelete(DeleteBehavior.SetNull);
            });
        }
    }
}
