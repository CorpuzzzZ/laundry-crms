        private void BuildChemicalRows()
        {
            pnlChemical.Controls.Clear();

            pnlChemical.Controls.Add(new Label
            {
                Text = "Chemical Add-ons",
                Font = new Font("Segoe UI", 9.5F, FontStyle.Bold),
                ForeColor = Theme.TextDarkColor,
                Dock = DockStyle.Top,
                Height = 24,
                TextAlign = ContentAlignment.MiddleLeft,
                Padding = new Padding(4, 0, 0, 0)
            });

            if (_chemicals.Count == 0)
            {
                pnlChemical.Controls.Add(new Label
                {
                    Text = "None available",
                    Font = Theme.SmallFont,
                    ForeColor = Theme.TextLightColor,
                    Dock = DockStyle.Top,
                    Height = 22,
                    Padding = new Padding(6, 2, 0, 0)
                });
                return;
            }

            // Add in reverse so the first item ends up on top after Dock=Top
            for (int i = _chemicals.Count - 1; i >= 0; i--)
            {
                var c = _chemicals[i];
                var chk = new CheckBox
                {
                    Text = $"{c.ServiceName}  -  PHP {c.BasePrice:N0}",
                    Dock = DockStyle.Top,
                    Height = 28,
                    Padding = new Padding(6, 4, 0, 0),
                    Font = Theme.BodyFont,
                    ForeColor = Theme.TextDarkColor,
                    BackColor = Color.Transparent,
                    Checked = _chemQty.TryGetValue(c.ServiceId, out var q) && q > 0,
                    Tag = c.ServiceId,
                    AutoEllipsis = true
                };
                chk.CheckedChanged += (s, e) =>
                {
                    int id = (int)((CheckBox)s).Tag;
                    _chemQty[id] = ((CheckBox)s).Checked ? 1 : 0;
                    Recalculate();
                };
                pnlChemical.Controls.Add(chk);
                chk.BringToFront();
            }
            System.IO.File.AppendAllText(@"C:\temp\order_debug.log", $"[chain] pnlChemical={pnlChemical.Bounds} pnlChemContainer={pnlChemical.Parent?.Bounds} pnlAddOns={pnlChemical.Parent?.Parent?.Bounds} card={pnlChemical.Parent?.Parent?.Parent?.Bounds} cardDock={pnlChemical.Parent?.Parent?.Parent?.Dock}`r`n");
        }

