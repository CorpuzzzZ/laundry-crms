            // ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ CUSTOMER & ORDER card (2 rows ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â 2 cols) ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬
            var cardInfo = new RoundedCard
            {
                Location = new Point(Spacing.Xl, y),
                Width = 700,   // will resize with body
                Height = 200,
                Padding = new Padding(Spacing.Lg),
                CornerRadius = 8,
                FillColor = Colors.Surface,
                BorderColor = Colors.Border,
                ShowShadow = true,
                Anchor = AnchorStyles.Top | AnchorStyles.Left | AnchorStyles.Right
            };
            pnlBody.Controls.Add(cardInfo);

            cardInfo.Controls.Add(new Label
            {
                Text = "CUSTOMER & ORDER",
                Font = Typography.TinyUpper,
                ForeColor = Colors.TextMuted,
                Location = new Point(Spacing.Lg, 16),
                AutoSize = true
            });

            // Row 1: Customer | Order Date
            cardInfo.Controls.Add(new Label
            {
                Text = "Customer *",
                Font = Typography.Small,
                ForeColor = Colors.TextSecondary,
                Location = new Point(Spacing.Lg, 44),
                AutoSize = true
            });
            cmbCustomer = new ComboBox
            {
                Location = new Point(Spacing.Lg, 64),
                Width = 380,
                Font = Typography.Body,
                DropDownStyle = ComboBoxStyle.DropDownList
            };
            cardInfo.Controls.Add(cmbCustomer);

            cardInfo.Controls.Add(new Label
            {
                Text = "Order Date",
                Font = Typography.Small,
                ForeColor = Colors.TextSecondary,
                Location = new Point(Spacing.Lg + 400, 44),
                AutoSize = true
            });
            lblOrderDate = new Label
            {
                Text = DateTime.Now.ToString("yyyy-MM-dd HH:mm"),
                Location = new Point(Spacing.Lg + 400, 64),
                Width = 260,
                Height = 32,
                Font = Typography.Body,
                ForeColor = Colors.TextPrimary,
                BackColor = Colors.Background,
                BorderStyle = BorderStyle.FixedSingle,
                TextAlign = ContentAlignment.MiddleLeft,
                Padding = new Padding(6, 0, 0, 0)
            };
            cardInfo.Controls.Add(lblOrderDate);

            // Row 2: Notes (full width)
            cardInfo.Controls.Add(new Label
            {
                Text = "Notes (optional)",
                Font = Typography.Small,
                ForeColor = Colors.TextSecondary,
                Location = new Point(Spacing.Lg, 110),
                AutoSize = true
            });
            txtNotes = new TextBox
            {
                Location = new Point(Spacing.Lg, 130),
                Width = 660,
                Height = 32,
                Font = Typography.Body,
                BorderStyle = BorderStyle.FixedSingle,
                Anchor = AnchorStyles.Top | AnchorStyles.Left | AnchorStyles.Right
            };
            cardInfo.Controls.Add(txtNotes);

            // Card resize handler
            cardInfo.Resize += (s, e) =>
            {
                int w = cardInfo.Width - Spacing.Lg * 2 - 12;
                txtNotes.Width = Math.Max(200, w);
            };

            y += cardInfo.Height + Spacing.Xl;

            // ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ ITEMS card with header row containing "+ Add Item" on the right ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬
            var cardItems = new RoundedCard
            {
                Location = new Point(Spacing.Xl, y),
                Width = 700,
                Height = 500,
                Padding = new Padding(Spacing.Lg),
                CornerRadius = 8,
                FillColor = Colors.Surface,
                BorderColor = Colors.Border,
                ShowShadow = true,
                Anchor = AnchorStyles.Top | AnchorStyles.Left | AnchorStyles.Right
            };
            pnlBody.Controls.Add(cardItems);

            // Top bar: ITEMS label + Add Item button
            var pnlItemsHeader = new Panel
            {
                Dock = DockStyle.Top,
                Height = 52,
                BackColor = Colors.Surface
            };
            cardItems.Controls.Add(pnlItemsHeader);

            pnlItemsHeader.Controls.Add(new Label
            {
                Text = "ITEMS",
                Font = Typography.TinyUpper,
                ForeColor = Colors.TextMuted,
                Location = new Point(Spacing.Lg, 20),
                AutoSize = true
            });

            btnAddItem = new Button
            {
                Text = "+ Add Item",
                Width = 130,
                Height = 36,
                FlatStyle = FlatStyle.Flat,
                BackColor = Colors.Success,
                ForeColor = Color.White,
                Font = Typography.BodyBold,
                Cursor = Cursors.Hand,
                Anchor = AnchorStyles.Top | AnchorStyles.Right
            };
            btnAddItem.FlatAppearance.BorderSize = 0;
            btnAddItem.Location = new Point(pnlItemsHeader.Width - 160, 8);
            btnAddItem.Click += async (s, e) => await AddItemAsync();
            pnlItemsHeader.Controls.Add(btnAddItem);
            pnlItemsHeader.Resize += (s, e) =>
            {
                btnAddItem.Location = new Point(pnlItemsHeader.Width - 160, 8);
            };

            // Items container (vertical flow, fills below header)
            pnlItems = new FlowLayoutPanel
            {
                Location = new Point(15, 60),
                Size = new Size(1000, 380),
                AutoScroll = true,
                FlowDirection = FlowDirection.TopDown,
                WrapContents = false,
                BackColor = Color.LightYellow,
                BorderStyle = BorderStyle.FixedSingle,
                Padding = new Padding(0)
            };
            cardItems.Controls.Add(pnlItems);
            pnlItems.BringToFront();

            pnlItems.Resize += (s, e) =>
            {
                int targetWidth = Math.Max(600, pnlItems.ClientSize.Width - 20);
                foreach (Control c in pnlItems.Controls)
                {
                    if (c is OrderItemCard card)
                        card.Width = targetWidth;
                }
            };
            pnlItems.BringToFront();

            pnlItems.Resize += (s, e) =>
            {
                int targetWidth = pnlItems.ClientSize.Width - 4;
                foreach (Control c in pnlItems.Controls)
                {
                    if (c is OrderItemCard card)
                        card.Width = Math.Max(600, targetWidth);
                }
            };

            y += cardItems.Height + Spacing.Xl;

            // ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ BILLING SUMMARY card ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬
            var cardBilling = new RoundedCard
            {
                Location = new Point(Spacing.Xl, y),
                Width = 700,
                Height = 220,
                Padding = new Padding(Spacing.Lg),
                CornerRadius = 8,
                FillColor = Colors.Surface,
                BorderColor = Colors.Border,
                ShowShadow = true,
                Anchor = AnchorStyles.Top | AnchorStyles.Left | AnchorStyles.Right
            };
            pnlBody.Controls.Add(cardBilling);

            cardBilling.Controls.Add(new Label
            {
                Text = "BILLING SUMMARY",
                Font = Typography.TinyUpper,
                ForeColor = Colors.TextMuted,
                Location = new Point(Spacing.Lg, 16),
                AutoSize = true
            });

            int by = 60;
            int labelWidth = 500;
            int valueWidth = 180;

            lblSubtotal = MakeBillRow(cardBilling, "Items Subtotal", by, labelWidth, valueWidth);
            lblChemical = MakeBillRow(cardBilling, "Chemical Add-ons", by + 34, labelWidth, valueWidth);
            lblMachine = MakeBillRow(cardBilling, "Machine Add-ons", by + 68, labelWidth, valueWidth);

            // TOTAL row
            cardBilling.Controls.Add(new Label
            {
                Text = "TOTAL",
                Font = Typography.H3,
                ForeColor = Colors.TextPrimary,
                Location = new Point(Spacing.Lg, by + 110),
                AutoSize = true
            });
            lblTotal = new Label
            {
                Text = "PHP 0.00",
                Font = Typography.H2,
                ForeColor = Colors.Primary,
                Location = new Point(Spacing.Lg + labelWidth, by + 108),
                Width = valueWidth,
                Height = 30,
                TextAlign = ContentAlignment.MiddleRight,
                Anchor = AnchorStyles.Top | AnchorStyles.Right
            };
            cardBilling.Controls.Add(lblTotal);

            // Card resize handler
            cardBilling.Resize += (s, e) =>
            {
                int valueX = cardBilling.Width - valueWidth - Spacing.Lg;
                foreach (Control c in cardBilling.Controls)
                {
                    if (c is Label lbl && lbl.Text.StartsWith("PHP") && c != lblTotal)
                        lbl.Location = new Point(valueX, lbl.Location.Y);
                }
                lblTotal.Location = new Point(valueX, lblTotal.Location.Y);
            };

            y += cardBilling.Height + Spacing.Lg;

            // Set body scrollable content height
