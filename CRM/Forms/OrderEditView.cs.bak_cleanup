            var pnlFooter = new Panel
            {
                Dock = DockStyle.Bottom,
                Height = 72,
                BackColor = Colors.Surface
            };
            pnlFooter.Paint += (s, e) =>
            {
                using var pen = new Pen(Colors.Border);
                e.Graphics.DrawLine(pen, 0, 0, pnlFooter.Width, 0);
            };

            btnCancelBottom = new Button
            {
                Text = "Cancel",
                Width = 130,
                Height = 44,
                FlatStyle = FlatStyle.Flat,
                BackColor = Colors.Surface,
                ForeColor = Colors.TextPrimary,
                Font = Typography.BodyBold,
                Cursor = Cursors.Hand,
                Anchor = AnchorStyles.Top | AnchorStyles.Right
            };
            btnCancelBottom.FlatAppearance.BorderColor = Colors.Border;
            btnCancelBottom.Click += (s, e) => Cancelled?.Invoke(this, EventArgs.Empty);
            pnlFooter.Controls.Add(btnCancelBottom);

            btnSaveBottom = new Button
            {
                Text = "Save Order",
                Width = 160,
                Height = 44,
                FlatStyle = FlatStyle.Flat,
                BackColor = Colors.Primary,
                ForeColor = Color.White,
                Font = Typography.BodyBold,
                Cursor = Cursors.Hand,
                Anchor = AnchorStyles.Top | AnchorStyles.Right
            };
            btnSaveBottom.FlatAppearance.BorderSize = 0;
            btnSaveBottom.Click += async (s, e) => await SaveAsync();
            pnlFooter.Controls.Add(btnSaveBottom);

            // Position footer buttons at right
            pnlFooter.Resize += (s, e) =>
            {
                btnSaveBottom.Location = new Point(pnlFooter.Width - 180, 14);
                btnCancelBottom.Location = new Point(pnlFooter.Width - 320, 14);
            };

            Controls.Add(pnlFooter);

