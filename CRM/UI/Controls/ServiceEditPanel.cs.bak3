        private NumericUpDown numProcessingHours = null!;
        private CheckBox chkSpecialHandling = null!;
        private TextBox txtHandlingInstructions = null!;
        private NumericUpDown numSortOrder = null!;
        private CheckBox chkIsActive = null!;

        private DataGridView gridAddOns = null!;
        private Button btnAddAddOn = null!;
        private Button btnEditAddOn = null!;
        private Button btnDeleteAddOn = null!;

        private Button btnSave = null!;
        private Button btnArchive = null!;
        private Button btnRestore = null!;
        private Button btnCancel = null!;

        private List<ServiceAddOnModel> _addOns = new();

        public ServiceEditPanel(int serviceId)
        {
            _serviceId = serviceId;
            InitializeComponent();
            Load += async (s, e) => await LoadAsync();
        }

        private bool IsCreate => _serviceId == 0;

        private void InitializeComponent()
        {
            Dock = DockStyle.Fill;
            BackColor = Colors.Background;
            AutoScroll = true;
            Padding = new Padding(Spacing.Xl, Spacing.Lg, Spacing.Xl, Spacing.Xl);

