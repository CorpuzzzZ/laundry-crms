            int col2Left = contentLeft + twoColWidth + Spacing.Md;
            int y = 0;

            // â”€â”€ HEADER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            lblTitle = new Label
            {
                Text = IsCreate ? "New Service" : "Edit Service",
