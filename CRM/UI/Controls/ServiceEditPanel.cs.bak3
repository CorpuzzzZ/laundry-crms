        // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        // Helpers
        // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        private static void AddSectionTitle(Control parent, string text, int x, int y)
        {
            parent.Controls.Add(new Label
            {
                Text = text,
                Font = Typography.TinyUpper,
                ForeColor = Colors.TextMuted,
                Location = new Point(x, y),
                AutoSize = true
            });
        }

        private static void AddFieldLabel(Control parent, string text, int x, int y)
        {
            parent.Controls.Add(new Label
            {
                Text = text,
                Font = Typography.Small,
                ForeColor = Colors.TextSecondary,
                Location = new Point(x, y),
                AutoSize = true
            });
        }

        private static TextBox AddTextBox(Control parent, int x, int y, int width)
        {
            var txt = new TextBox
            {
                Location = new Point(x, y),
                Width = width,
                Height = 32,
                Font = Typography.Body,
                BorderStyle = BorderStyle.FixedSingle,
                BackColor = Colors.Surface
            };
            parent.Controls.Add(txt);
            return txt;
        }

        private static NumericUpDown AddNumeric(Control parent, int x, int y, int width, decimal min, decimal max)
        {
            var num = new NumericUpDown
            {
                Location = new Point(x, y),
                Width = width,
                Height = 32,
                Font = Typography.Body,
                BorderStyle = BorderStyle.FixedSingle,
                BackColor = Colors.Surface,
                Minimum = min,
                Maximum = max
            };
            parent.Controls.Add(num);
            return num;
        }

        private void UpdateAddOnButtons()
        {
            bool hasSelection = gridAddOns.SelectedRows.Count > 0;
            btnEditAddOn.Enabled = hasSelection && !(_existing?.IsArchived ?? false);
            btnDeleteAddOn.Enabled = hasSelection && !(_existing?.IsArchived ?? false);
            btnAddAddOn.Enabled = !(_existing?.IsArchived ?? false);
        }

        // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        // LOAD
        // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        private async Task LoadAsync()
        {
            try
            {
                // Load categories
                _categories = await _serviceApi.GetCategoriesAsync();
                cmbCategory.Items.Clear();
                foreach (var c in _categories)
                    cmbCategory.Items.Add(c.CategoryName);
                if (cmbCategory.Items.Count > 0)
                    cmbCategory.SelectedIndex = 0;

                if (IsCreate) return;

                // Load service
                var svc = await _serviceApi.GetByIdAsync(_serviceId);
                if (svc == null)
                {
                    MessageBox.Show("Service not found.", "Error",
                        MessageBoxButtons.OK, MessageBoxIcon.Error);
                    Cancelled?.Invoke(this, EventArgs.Empty);
                    return;
                }

                _existing = svc;
                cmbServiceType.SelectedIndex = Math.Max(0, Math.Min(2, svc.ServiceType - 1));
                ApplyTypeLayout();
                lblServiceCode.Text = svc.ServiceCode;
                txtServiceName.Text = svc.ServiceName;
                txtDescription.Text = svc.Description ?? "";
                txtUnitOfMeasure.Text = svc.UnitOfMeasure;

                numBasePrice.Value = Math.Min(svc.BasePrice, numBasePrice.Maximum);
                if (svc.PricePerUnit.HasValue)
                    numPricePerUnit.Value = Math.Min(svc.PricePerUnit.Value, numPricePerUnit.Maximum);
                chkIsExpress.Checked = svc.IsExpressService;
                if (svc.ExpressMultiplier.HasValue)
                    numExpressMultiplier.Value = Math.Min(svc.ExpressMultiplier.Value, numExpressMultiplier.Maximum);
                numProcessingHours.Value = Math.Min(svc.ProcessingTimeHours, numProcessingHours.Maximum);
                chkSpecialHandling.Checked = svc.RequiresSpecialHandling;
                txtHandlingInstructions.Text = svc.HandlingInstructions ?? "";
                numSortOrder.Value = Math.Min(svc.SortOrder, numSortOrder.Maximum);
                chkIsActive.Checked = svc.IsActive;

                // Select category
                var catIdx = _categories.FindIndex(c => c.ServiceCategoryId == svc.ServiceCategoryId);
                if (catIdx >= 0) cmbCategory.SelectedIndex = catIdx;

                // Add-ons
                _addOns = svc.AddOns ?? new();
                RefreshAddOnGrid();

                // Archive mode
                var currentUser = SessionManager.CurrentUser;
                if (svc.IsArchived)
                {
                    lblTitle.Text = "Archived Service";
                    lblTitle.ForeColor = Colors.TextMuted;
                    btnSave.Visible = false;
                    btnArchive.Visible = false;
                    if (currentUser?.IsAdmin == true) btnRestore.Visible = true;
                    MakeReadOnly();
                    SetStatus("This service is archived. Restore to make changes.", Colors.Warning);
                }
                else if (currentUser?.IsAdmin == true)
                {
                    btnArchive.Visible = true;
                }
            }
            catch (Exception ex)
            {
                SetStatus("Load error: " + ex.Message, Colors.Danger);
            }
        }

        private void RefreshAddOnGrid()
        {
            gridAddOns.Rows.Clear();
            foreach (var a in _addOns.OrderBy(x => x.SortOrder))
            {
                gridAddOns.Rows.Add(a.AddOnName, a.PriceDisplay, a.IsActive, a.SortOrder);
            }
        }

        private void AddAddOn()
        {
            using var dlg = new ServiceAddOnDialog(null);
            if (dlg.ShowDialog(this) == DialogResult.OK && dlg.Result != null)
            {
                _addOns.Add(dlg.Result);
                RefreshAddOnGrid();
            }
        }

        private void EditAddOn()
        {
            if (gridAddOns.SelectedRows.Count == 0) return;
            var idx = gridAddOns.SelectedRows[0].Index;
            if (idx < 0 || idx >= _addOns.Count) return;

            using var dlg = new ServiceAddOnDialog(_addOns[idx]);
            if (dlg.ShowDialog(this) == DialogResult.OK && dlg.Result != null)
            {
                _addOns[idx] = dlg.Result;
                RefreshAddOnGrid();
            }
        }

        private async Task DeleteAddOnAsync()
        {
            if (gridAddOns.SelectedRows.Count == 0) return;
            var idx = gridAddOns.SelectedRows[0].Index;
            if (idx < 0 || idx >= _addOns.Count) return;

            var addOn = _addOns[idx];
            if (MessageBox.Show($"Remove add-on \"{addOn.AddOnName}\"?", "Confirm",
                MessageBoxButtons.YesNo, MessageBoxIcon.Question) != DialogResult.Yes)
                return;

            // For existing services, delete from server
            if (!IsCreate && addOn.ServiceAddOnId > 0)
            {
                try { await _serviceApi.DeleteAddOnAsync(_serviceId, addOn.ServiceAddOnId); }
                catch (Exception ex) { SetStatus("Delete failed: " + ex.Message, Colors.Danger); return; }
            }

            _addOns.RemoveAt(idx);
            RefreshAddOnGrid();
        }

        private void MakeReadOnly()
        {
            foreach (var tb in new[] { txtServiceName, txtDescription, txtUnitOfMeasure, txtHandlingInstructions })
                if (tb != null) { tb.ReadOnly = true; tb.BackColor = Colors.Background; tb.ForeColor = Colors.TextMuted; }

            if (cmbCategory != null) cmbCategory.Enabled = false;
            if (numBasePrice != null) numBasePrice.Enabled = false;
            if (numPricePerUnit != null) numPricePerUnit.Enabled = false;
            if (numExpressMultiplier != null) numExpressMultiplier.Enabled = false;
            if (numProcessingHours != null) numProcessingHours.Enabled = false;
            if (numSortOrder != null) numSortOrder.Enabled = false;
            if (chkIsExpress != null) chkIsExpress.Enabled = false;
            if (chkSpecialHandling != null) chkSpecialHandling.Enabled = false;
            if (chkIsActive != null) chkIsActive.Enabled = false;

            if (btnAddAddOn != null) btnAddAddOn.Enabled = false;
            if (btnEditAddOn != null) btnEditAddOn.Enabled = false;
            if (btnDeleteAddOn != null) btnDeleteAddOn.Enabled = false;
        }

        // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        // SAVE
        // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        private void ApplyTypeLayout()
        {
            bool isBase = cmbServiceType == null || cmbServiceType.SelectedIndex == 0;

            // ── Category: base only ──
            if (cmbCategory != null) cmbCategory.Visible = isBase;
            if (lblCategoryField != null) lblCategoryField.Visible = isBase;
            if (cmbCategory != null && !isBase) cmbCategory.SelectedIndex = -1;

            // ── Unit of Measure: base only ──
            if (txtUnitOfMeasure != null) txtUnitOfMeasure.Visible = isBase;
            if (lblUnitField != null) lblUnitField.Visible = isBase;

            // ── Price Per Unit: base only ──
            if (numPricePerUnit != null) numPricePerUnit.Visible = isBase;
            if (lblPricePerUnitField != null) lblPricePerUnitField.Visible = isBase;

            // ── Express toggle + multiplier: base only ──
            if (chkIsExpress != null) chkIsExpress.Visible = isBase;
            if (numExpressMultiplier != null) numExpressMultiplier.Visible = isBase;
            if (lblExpressMultiplierField != null) lblExpressMultiplierField.Visible = isBase;

            // ── Processing card: base only ──
            if (_cardProcessing != null) _cardProcessing.Visible = isBase;

            // ── Add-ons card: base only ──
            if (_cardAddOns != null) _cardAddOns.Visible = isBase;

            PerformLayout();
        }

        private async Task SaveAsync()
        {
            if (string.IsNullOrWhiteSpace(txtServiceName.Text))
            { SetStatus("Service Name is required.", Colors.Danger); txtServiceName.Focus(); return; }
            if (cmbServiceType.SelectedIndex == 0 && cmbCategory.SelectedIndex < 0)
            { SetStatus("Category is required for Base services.", Colors.Danger); cmbCategory.Focus(); return; }

            btnSave.Enabled = false;
            btnSave.Text = "Saving...";
            SetStatus("", Colors.TextPrimary);

            try
            {
                int? catId = cmbServiceType.SelectedIndex == 0 && cmbCategory.SelectedIndex >= 0
                    ? _categories[cmbCategory.SelectedIndex].ServiceCategoryId
                    : (int?)null;

                if (IsCreate)
                {
                    var request = new CreateServiceRequest
                    {
                        ServiceType = cmbServiceType.SelectedIndex + 1,
                        ServiceCategoryId = catId,
                        ServiceName = txtServiceName.Text.Trim(),
                        Description = NullIfEmpty(txtDescription.Text),
                        BasePrice = numBasePrice.Value,
                        PricePerUnit = numPricePerUnit.Value > 0 ? numPricePerUnit.Value : (decimal?)null,
                        UnitOfMeasure = string.IsNullOrWhiteSpace(txtUnitOfMeasure.Text) ? "Item" : txtUnitOfMeasure.Text.Trim(),
                        ProcessingTimeHours = (int)numProcessingHours.Value,
                        IsExpressService = chkIsExpress.Checked,
                        ExpressMultiplier = chkIsExpress.Checked ? numExpressMultiplier.Value : (decimal?)null,
                        RequiresSpecialHandling = chkSpecialHandling.Checked,
                        HandlingInstructions = NullIfEmpty(txtHandlingInstructions.Text),
                        IsActive = chkIsActive.Checked,
                        SortOrder = (int)numSortOrder.Value,
                        AddOns = _addOns.Select(a => new CreateServiceAddOnRequest
                        {
                            AddOnName = a.AddOnName,
                            Description = a.Description,
                            AdditionalPrice = a.AdditionalPrice,
                            IsActive = a.IsActive,
                            SortOrder = a.SortOrder
                        }).ToList()
                    };

                    var result = await _serviceApi.CreateAsync(request);
                    if (result == null)
                    {
                        SetStatus("Failed to create service. Check server logs.", Colors.Danger);
                        return;
                    }

                    MessageBox.Show($"Service created successfully.\n\nCode: {result.ServiceCode}",
                        "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    Saved?.Invoke(this, EventArgs.Empty);
                }
                else
                {
                    var request = new UpdateServiceRequest
                    {
                        ServiceType = cmbServiceType.SelectedIndex + 1,
                        ServiceCategoryId = catId,
                        ServiceName = txtServiceName.Text.Trim(),
                        Description = NullIfEmpty(txtDescription.Text),
                        BasePrice = numBasePrice.Value,
                        PricePerUnit = numPricePerUnit.Value > 0 ? numPricePerUnit.Value : (decimal?)null,
                        UnitOfMeasure = string.IsNullOrWhiteSpace(txtUnitOfMeasure.Text) ? "Item" : txtUnitOfMeasure.Text.Trim(),
                        ProcessingTimeHours = (int)numProcessingHours.Value,
                        IsExpressService = chkIsExpress.Checked,
                        ExpressMultiplier = chkIsExpress.Checked ? numExpressMultiplier.Value : (decimal?)null,
                        RequiresSpecialHandling = chkSpecialHandling.Checked,
                        HandlingInstructions = NullIfEmpty(txtHandlingInstructions.Text),
                        IsActive = chkIsActive.Checked,
                        SortOrder = (int)numSortOrder.Value
                    };

                    var result = await _serviceApi.UpdateAsync(_serviceId, request);
                    if (result == null)
                    {
                        SetStatus("Failed to update service.", Colors.Danger);
                        return;
                    }

                    // Sync add-ons: for existing service, add new ones via API
                    foreach (var a in _addOns.Where(x => x.ServiceAddOnId == 0))
                    {
                        await _serviceApi.AddAddOnAsync(_serviceId, new CreateServiceAddOnRequest
                        {
                            AddOnName = a.AddOnName,
                            Description = a.Description,
                            AdditionalPrice = a.AdditionalPrice,
                            IsActive = a.IsActive,
                            SortOrder = a.SortOrder
                        });
                    }

                    MessageBox.Show("Service updated successfully.", "Success",
                        MessageBoxButtons.OK, MessageBoxIcon.Information);
                    Saved?.Invoke(this, EventArgs.Empty);
                }
            }
            catch (Exception ex)
            {
                SetStatus("Error: " + ex.Message, Colors.Danger);
            }
            finally
            {
                btnSave.Enabled = true;
                btnSave.Text = IsCreate ? "Create Service" : "Save Changes";
            }
        }

        private async Task ArchiveAsync()
        {
            var user = SessionManager.CurrentUser;
            if (user?.IsAdmin != true) { SetStatus("Only Admin can archive services.", Colors.Danger); return; }

            var confirm = MessageBox.Show(
                $"Archive service \"{_existing?.ServiceName}\"?\n\nThe service will be hidden from the main list.",
                "Confirm Archive", MessageBoxButtons.YesNo, MessageBoxIcon.Warning, MessageBoxDefaultButton.Button2);
            if (confirm != DialogResult.Yes) return;

            btnArchive.Enabled = false;
            btnArchive.Text = "Archiving...";
            try
            {
                var ok = await _serviceApi.ArchiveAsync(_serviceId);
                if (!ok) { SetStatus("Failed to archive.", Colors.Danger); return; }
                MessageBox.Show("Service archived successfully.", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                Saved?.Invoke(this, EventArgs.Empty);
            }
            catch (Exception ex) { SetStatus("Error: " + ex.Message, Colors.Danger); }
            finally { btnArchive.Enabled = true; btnArchive.Text = "Archive Service"; }
        }

        private async Task RestoreAsync()
        {
            var user = SessionManager.CurrentUser;
            if (user?.IsAdmin != true) { SetStatus("Only Admin can restore services.", Colors.Danger); return; }

            var confirm = MessageBox.Show(
                $"Restore service \"{_existing?.ServiceName}\"?",
                "Confirm Restore", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (confirm != DialogResult.Yes) return;

            btnRestore.Enabled = false;
            btnRestore.Text = "Restoring...";
            try
            {
                var result = await _serviceApi.RestoreAsync(_serviceId);
                if (result == null) { SetStatus("Failed to restore.", Colors.Danger); return; }
                MessageBox.Show("Service restored successfully.", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                Saved?.Invoke(this, EventArgs.Empty);
            }
            catch (Exception ex) { SetStatus("Error: " + ex.Message, Colors.Danger); }
            finally { btnRestore.Enabled = true; btnRestore.Text = "Restore Service"; }
        }

        private void SetStatus(string text, Color color)
        {
            lblStatus.Text = text;
            lblStatus.ForeColor = color;
        }

        private static string? NullIfEmpty(string? value)
            => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }
}
