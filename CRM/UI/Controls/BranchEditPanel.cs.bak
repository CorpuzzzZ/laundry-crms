using System;
using System.Drawing;
using System.Threading.Tasks;
using System.Windows.Forms;
using CRM.UI;
using CRM.WinForms.Models;
using CRM.WinForms.Services;

namespace CRM.UI.Controls
{
    /// <summary>
    /// Create/edit form for a branch — modern card-based layout.
    /// Branch code is auto-generated by the server.
    /// </summary>
    public class BranchEditPanel : UserControl
    {
        public event EventHandler? Saved;
        public event EventHandler? Cancelled;

        private readonly BranchApiService _branchService = new(ApiClient.Instance);
        private readonly int _branchId;
        private BranchModel? _existing;

        private Label lblBranchCode = null!;
        private TextBox txtBranchName = null!;
        private TextBox txtEmail = null!;
        private TextBox txtPhone = null!;

        private TextBox txtStreet = null!;
        private TextBox txtVillage = null!;
        private TextBox txtCity = null!;
        private TextBox txtProvince = null!;
        private TextBox txtPostalCode = null!;
        private TextBox txtCountry = null!;

        private CheckBox chkIsActive = null!;
        private Label lblTitle = null!;
        private Label lblStatus = null!;
        private Button btnSave = null!;
        private Button btnCancel = null!;

        public BranchEditPanel(int branchId)
        {
            _branchId = branchId;
            InitializeComponent();
            Load += async (s, e) => await LoadAsync();
        }

        private void InitializeComponent()
        {
            Dock = DockStyle.Fill;
            BackColor = Colors.Background;
            AutoScroll = true;
            Padding = new Padding(Spacing.Xl, Spacing.Lg, Spacing.Xl, Spacing.Xl);

            int cardWidth = 900;
            int contentLeft = Spacing.Lg;
            int twoColWidth = (cardWidth - Spacing.Xl * 2 - Spacing.Md) / 2;
            int col2Left = contentLeft + twoColWidth + Spacing.Md;

            int y = 0;

            // ── HEADER ─────────────────────────────────────────
            lblTitle = new Label
            {
                Text = _branchId == 0 ? "New Branch" : "Edit Branch",
                Font = Typography.H1,
                ForeColor = Colors.TextPrimary,
                AutoSize = true,
                Location = new Point(0, y)
            };
            Controls.Add(lblTitle);

            y += lblTitle.Height + Spacing.Md;

            // ── BASIC INFORMATION CARD ─────────────────────────
            var cardBasic = new RoundedCard
            {
                Location = new Point(0, y),
                Width = cardWidth,
                Padding = new Padding(Spacing.Xl),
                CornerRadius = 8,
                FillColor = Colors.Surface,
                BorderColor = Colors.Border,
                ShowShadow = true
            };
            Controls.Add(cardBasic);

            int cy = Spacing.Xl;
            AddSectionTitle(cardBasic, "BASIC INFORMATION", contentLeft, cy);
            cy += 32;

            // Row 1: Branch Code (read-only label) | Branch Name
            AddFieldLabel(cardBasic, "Branch Code", contentLeft, cy);
            lblBranchCode = new Label
            {
                Location = new Point(contentLeft, cy + 22),
                Width = twoColWidth,
                Height = 32,
                Font = Typography.BodyBold,
                ForeColor = Colors.Primary,
                TextAlign = ContentAlignment.MiddleLeft,
                Text = _branchId == 0 ? "(auto-generated)" : "",
                BackColor = Colors.Surface
            };
            cardBasic.Controls.Add(lblBranchCode);

            AddFieldLabel(cardBasic, "Branch Name", col2Left, cy);
            txtBranchName = AddTextBox(cardBasic, col2Left, cy + 22, twoColWidth);
            cy += 62;

            // Row 2: Email | Phone
            AddFieldLabel(cardBasic, "Email", contentLeft, cy);
            txtEmail = AddTextBox(cardBasic, contentLeft, cy + 22, twoColWidth);

            AddFieldLabel(cardBasic, "Phone", col2Left, cy);
            txtPhone = AddTextBox(cardBasic, col2Left, cy + 22, twoColWidth);
            cy += 62;

            cardBasic.Height = cy + Spacing.Lg;
            y += cardBasic.Height + Spacing.Xl;

            // ── ADDRESS CARD ───────────────────────────────────
            var cardAddress = new RoundedCard
            {
                Location = new Point(0, y),
                Width = cardWidth,
                Padding = new Padding(Spacing.Xl),
                CornerRadius = 8,
                FillColor = Colors.Surface,
                BorderColor = Colors.Border,
                ShowShadow = true
            };
            Controls.Add(cardAddress);

            cy = Spacing.Xl;
            AddSectionTitle(cardAddress, "ADDRESS", contentLeft, cy);
            cy += 32;

            // Row 1: Street | Village
            AddFieldLabel(cardAddress, "Street", contentLeft, cy);
            txtStreet = AddTextBox(cardAddress, contentLeft, cy + 22, twoColWidth);

            AddFieldLabel(cardAddress, "Village", col2Left, cy);
            txtVillage = AddTextBox(cardAddress, col2Left, cy + 22, twoColWidth);
            cy += 62;

            // Row 2: City | Province
            AddFieldLabel(cardAddress, "City", contentLeft, cy);
            txtCity = AddTextBox(cardAddress, contentLeft, cy + 22, twoColWidth);

            AddFieldLabel(cardAddress, "Province", col2Left, cy);
            txtProvince = AddTextBox(cardAddress, col2Left, cy + 22, twoColWidth);
            cy += 62;

            // Row 3: Postal Code | Country
            AddFieldLabel(cardAddress, "Postal Code", contentLeft, cy);
            txtPostalCode = AddTextBox(cardAddress, contentLeft, cy + 22, twoColWidth);

            AddFieldLabel(cardAddress, "Country", col2Left, cy);
            txtCountry = AddTextBox(cardAddress, col2Left, cy + 22, twoColWidth);
            txtCountry.Text = "Philippines";
            cy += 62;

            cardAddress.Height = cy + Spacing.Lg;
            y += cardAddress.Height + Spacing.Xl;

            // ── OPTIONS CARD (only on edit) ────────────────────
            if (_branchId > 0)
            {
                chkIsActive = new CheckBox
                {
                    Text = "Branch is active",
                    Font = Typography.Body,
                    ForeColor = Colors.TextBody,
                    Checked = true,
                    AutoSize = true,
                    Location = new Point(0, y)
                };
                Controls.Add(chkIsActive);
                y += 32;
            }

            // ── STATUS ─────────────────────────────────────────
            lblStatus = new Label
            {
                Location = new Point(0, y),
                Width = cardWidth,
                Height = 24,
                Font = Typography.Small,
                ForeColor = Colors.Danger,
                TextAlign = ContentAlignment.MiddleCenter
            };
            Controls.Add(lblStatus);
            y += 32;

            // ── BUTTONS ────────────────────────────────────────
            btnCancel = new Button
            {
                Text = "Cancel",
                Location = new Point(cardWidth - 260, y),
                Width = 120,
                Height = 42,
                FlatStyle = FlatStyle.Flat,
                BackColor = Colors.Surface,
                ForeColor = Colors.TextPrimary,
                Font = Typography.BodyBold,
                Cursor = Cursors.Hand
            };
            btnCancel.FlatAppearance.BorderColor = Colors.Border;
            btnCancel.Click += (s, e) => Cancelled?.Invoke(this, EventArgs.Empty);
            Controls.Add(btnCancel);

            btnSave = new Button
            {
                Text = _branchId == 0 ? "Create Branch" : "Save Changes",
                Location = new Point(cardWidth - 130, y),
                Width = 130,
                Height = 42,
                FlatStyle = FlatStyle.Flat,
                BackColor = Colors.Primary,
                ForeColor = Color.White,
                Font = Typography.BodyBold,
                Cursor = Cursors.Hand
            };
            btnSave.FlatAppearance.BorderSize = 0;
            btnSave.Click += async (s, e) => await SaveAsync();
            Controls.Add(btnSave);
        }

        private static void AddSectionTitle(Control parent, string text, int x, int y)
        {
            var lbl = new Label
            {
                Text = text,
                Font = Typography.TinyUpper,
                ForeColor = Colors.TextMuted,
                Location = new Point(x, y),
                AutoSize = true
            };
            parent.Controls.Add(lbl);
        }

        private static void AddFieldLabel(Control parent, string text, int x, int y)
        {
            var lbl = new Label
            {
                Text = text,
                Font = Typography.Small,
                ForeColor = Colors.TextSecondary,
                Location = new Point(x, y),
                AutoSize = true
            };
            parent.Controls.Add(lbl);
        }

        private static TextBox AddTextBox(Control parent, int x, int y, int width)
        {
            var txt = new TextBox
            {
                Location = new Point(x, y),
                Width = width,
                Height = 32,
                Font = Typography.Body,
                BorderStyle = BorderStyle.FixedSingle,
                BackColor = Colors.Surface
            };
            parent.Controls.Add(txt);
            return txt;
        }

        private async Task LoadAsync()
        {
            if (_branchId <= 0) return;

            var branch = await _branchService.GetByIdAsync(_branchId);
            if (branch == null)
            {
                MessageBox.Show("Branch not found.", "Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
                Cancelled?.Invoke(this, EventArgs.Empty);
                return;
            }

            _existing = branch;

            lblBranchCode.Text = branch.BranchCode;
            txtBranchName.Text = branch.BranchName;
            txtEmail.Text = branch.Email ?? "";
            txtPhone.Text = branch.Phone;
            txtStreet.Text = branch.Street;
            txtVillage.Text = branch.Village ?? "";
            txtCity.Text = branch.City;
            txtProvince.Text = branch.Province ?? "";
            txtPostalCode.Text = branch.PostalCode;
            txtCountry.Text = branch.Country;

            if (chkIsActive != null)
                chkIsActive.Checked = branch.IsActive;
        }

        private async Task SaveAsync()
        {
            // Validation
            if (string.IsNullOrWhiteSpace(txtBranchName.Text))
            {
                SetStatus("Branch Name is required.", Colors.Danger);
                txtBranchName.Focus();
                return;
            }
            if (string.IsNullOrWhiteSpace(txtPhone.Text))
            {
                SetStatus("Phone is required.", Colors.Danger);
                txtPhone.Focus();
                return;
            }
            if (string.IsNullOrWhiteSpace(txtStreet.Text))
            {
                SetStatus("Street is required.", Colors.Danger);
                txtStreet.Focus();
                return;
            }
            if (string.IsNullOrWhiteSpace(txtCity.Text))
            {
                SetStatus("City is required.", Colors.Danger);
                txtCity.Focus();
                return;
            }

            btnSave.Enabled = false;
            btnSave.Text = "Saving...";
            SetStatus("", Colors.TextPrimary);

            try
            {
                if (_branchId == 0)
                {
                    var request = new CreateBranchRequest
                    {
                        BranchName = txtBranchName.Text.Trim(),
                        Email = NullIfEmpty(txtEmail.Text),
                        Phone = txtPhone.Text.Trim(),
                        Street = txtStreet.Text.Trim(),
                        Village = NullIfEmpty(txtVillage.Text),
                        City = txtCity.Text.Trim(),
                        Province = NullIfEmpty(txtProvince.Text),
                        PostalCode = txtPostalCode.Text.Trim(),
                        Country = NullIfEmpty(txtCountry.Text) ?? "Philippines"
                    };

                    var result = await _branchService.CreateAsync(request);

                    if (result == null)
                    {
                        SetStatus("Failed to create branch. Check server logs.", Colors.Danger);
                        return;
                    }

                    MessageBox.Show(
                        "Branch created successfully.\n\nCode: " + result.BranchCode,
                        "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    Saved?.Invoke(this, EventArgs.Empty);
                }
                else
                {
                    var request = new UpdateBranchRequest
                    {
                        BranchName = txtBranchName.Text.Trim(),
                        Email = NullIfEmpty(txtEmail.Text),
                        Phone = txtPhone.Text.Trim(),
                        Street = txtStreet.Text.Trim(),
                        Village = NullIfEmpty(txtVillage.Text),
                        City = txtCity.Text.Trim(),
                        Province = NullIfEmpty(txtProvince.Text),
                        PostalCode = txtPostalCode.Text.Trim(),
                        Country = NullIfEmpty(txtCountry.Text) ?? "Philippines",
                        IsActive = chkIsActive?.Checked ?? true
                    };

                    var result = await _branchService.UpdateAsync(_branchId, request);

                    if (result == null)
                    {
                        SetStatus("Failed to update branch.", Colors.Danger);
                        return;
                    }

                    MessageBox.Show("Branch updated successfully.",
                        "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    Saved?.Invoke(this, EventArgs.Empty);
                }
            }
            catch (Exception ex)
            {
                SetStatus("Error: " + ex.Message, Colors.Danger);
            }
            finally
            {
                btnSave.Enabled = true;
                btnSave.Text = _branchId == 0 ? "Create Branch" : "Save Changes";
            }
        }

        private void SetStatus(string text, Color color)
        {
            lblStatus.Text = text;
            lblStatus.ForeColor = color;
        }

        private static string? NullIfEmpty(string? value)
            => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }
}